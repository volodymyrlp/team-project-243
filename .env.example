# ============================================
#  Team Project #243 — environment variables example
#  Copy to .env and fill in. Never commit .env.
# ============================================

# --- Database (MySQL / Aiven) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/travel
SPRING_DATASOURCE_USERNAME=travel
SPRING_DATASOURCE_PASSWORD=travel
# Production (Aiven): jdbc:mysql://<host>:<port>/<db>?sslMode=REQUIRED

# --- Auth ---
JWT_SECRET=

# --- Image storage (Supabase, S3 protocol) ---
# Never put the production keys here. A Supabase S3 key is scoped to the whole
# project rather than to one bucket, so a production key on a laptop also reaches
# the production bucket. Ask DevOps for local values. See docs/STORAGE.md.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Nominatim (geocoding, called by the backend) ---
# User-Agent MUST include a real contact (Nominatim policy). Limit: 1 request/sec.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=team243-travel-planner (contact: your-email@example.com)

# --- Routing (OpenRouteService) ---
ORS_API_KEY=your_ors_key_here

# --- Frontend → backend URL ---
VITE_API_URL=http://localhost:8080
